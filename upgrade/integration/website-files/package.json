{
  "name": "milano-racing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "build:html": "node scripts/build-html.mjs",
    "build:private-game": "tsc -b && vite build --mode private-game --outDir dist-private-game",
    "preview:private-game": "python scripts/private-game-preview.py"
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "lucide-react": "^0.468.0",
    "mediabunny": "^1.61.6",
    "motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.2"
  }
