# Replace with your real HTTPS hostname, without a trailing slash.
PUBLIC_ORIGIN=https://game.milanoracing.team
BIND=127.0.0.1
PORT=8767
# Only trust Cloudflare's client IP header when received from loopback.
TRUST_CLOUDFLARE=1
# Private by default. Without credentials the game remains inaccessible.
# Run set-private-password.py on the Ubuntu server to populate these values.
PRIVATE_SITE=1
SITE_PASSWORD_HASH=
SESSION_SECRET=
